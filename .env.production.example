# Public API endpoints
NEXT_PUBLIC_PLATFORM_API_URL=https://api.mattr.ru
NEXT_PUBLIC_AUTH_URL=https://auth.mattr.ru
NEXT_PUBLIC_API_URL=https://api.mattr.ru/api
NEXT_PUBLIC_GOTRUE_URL=https://auth.mattr.ru/auth/v1

# Portal mode
NEXT_PUBLIC_IS_PLATFORM=true
NEXT_PUBLIC_ENVIRONMENT=production

# Captcha
NEXT_PUBLIC_ENABLE_HCAPTCHA=false
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# Public supabase-like keys for frontend integrations
NEXT_PUBLIC_SUPABASE_URL=https://api.mattr.ru
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_public_anon_jwt

# Optional status widget
NEXT_PUBLIC_ENABLE_INCIDENT_STATUS=false

# Upstream UI routes (proxy targets)
IOT_STUDIO_URL=https://stage.iot.mattr.ru
STUDIO_URL=https://studio.mattr.ru
BUILDER_URL=https://builder.mattr.ru

# Local container publish port
PORTAL_HTTP_PORT=3000

# Prebuilt image tag for docker-compose.production.yml
PORTAL_IMAGE=registry.mattr.ru/mattr/mattr-portal:latest
